{
  "name": "maquinas-checklist-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "npm run hooks:install",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --rulesdir ./.eslint/rules",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --fix --rulesdir ./.eslint/rules",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "verify:parallel": "npm-run-all --parallel lint typecheck",
    "verify": "npm run verify:parallel && npm run test:ui",
    "verify:full": "npm run verify && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:sync-authz": "node --no-warnings --experimental-strip-types scripts/sync-authz-catalog.mjs",
    "test:ui": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-dist/tests/app-views.test.js .test-dist/tests/auth-authorization.test.js"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.2",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "framer-motion": "11.18.2",
    "lucide-react": "0.379.0",
    "next": "14.2.3",
    "react": "19.2.8",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/react": "19.2.18",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "autoprefixer": "10.4.27",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.3",
    "npm-run-all": "^4.1.5",
    "postcss": "8.5.8",
    "prisma": "6.19.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
